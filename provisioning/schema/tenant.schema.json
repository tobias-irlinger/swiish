{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swiish.hm.edu/schema/tenant.schema.json",
  "title": "Swiish tenant manifest",
  "description": "One Swiish instance for one institution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "swiish.hm.edu/v1" },
    "kind": { "const": "Tenant" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "description": "Stable identifier: subdomain, organisation slug, client ID suffix. Never change it after go-live.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,29}$"
        },
        "name": { "description": "Official name of the institution.", "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contact", "identity"],
      "properties": {
        "host": { "description": "Public host name. Default: <id>.<baseDomain>.", "$ref": "#/$defs/hostname" },
        "language": { "description": "Language of card content (BCP 47).", "$ref": "#/$defs/language" },
        "contact": { "description": "Operational contact at the institution.", "type": "string", "format": "email" },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["idpEntityId", "homeOrganisations"],
          "properties": {
            "idpEntityId": { "description": "SAML entityID of the institution's IdP in DFN-AAI.", "type": "string", "format": "uri" },
            "homeOrganisations": {
              "description": "Accepted values of the home organisation claim (schacHomeOrganization). Only these users can log in.",
              "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/hostname" }
            },
            "emailDomains": {
              "description": "Optional additional restriction on email domains.",
              "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/hostname" }
            },
            "owners": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "emails": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "email" } },
                "entitlements": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "^[^,=\\s]+$" } }
              }
            },
            "roleSync": { "description": "Demote owners who no longer match on login.", "type": "boolean" },
            "autoProvision": { "type": "boolean" },
            "defaultRole": { "enum": ["member", "owner"] }
          }
        },
        "cards": { "$ref": "#/$defs/cards" },
        "branding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "displayName": { "description": "Organisation shown on cards. Default: metadata.name.", "type": "string", "minLength": 1, "maxLength": 200 },
            "themeVariant": { "enum": ["swiish", "minimal"] },
            "themeColors": {
              "type": "array", "minItems": 1, "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "primary", "secondary"],
                "properties": {
                  "name": { "type": "string", "pattern": "^[a-z0-9-]{1,50}$" },
                  "primary": { "$ref": "#/$defs/hex" },
                  "secondary": { "$ref": "#/$defs/hex" }
                }
              }
            },
            "allowThemeCustomisation": { "type": "boolean" },
            "allowImageCustomisation": { "type": "boolean" },
            "allowLinksCustomisation": { "type": "boolean" },
            "allowPrivacyCustomisation": { "type": "boolean" },
            "allowSendDetailsCustomisation": { "type": "boolean" }
          }
        }
      }
    }
  },
  "$defs": {
    "hostname": { "type": "string", "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$" },
    "language": { "type": "string", "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$" },
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "cardField": {
      "enum": [
        "personal.firstName", "personal.lastName", "personal.title", "personal.company", "personal.bio", "personal.location",
        "contact.email", "contact.phone", "contact.website",
        "social.linkedin", "social.twitter", "social.instagram", "social.github"
      ]
    },
    "cards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autoCreate": { "type": "boolean" },
        "limitPerUser": { "description": "0 = unlimited.", "type": "integer", "minimum": 0, "maximum": 1000 },
        "adoptExisting": { "type": "boolean" },
        "slugClaim": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
        "mapping": {
          "description": "Card field -> claim name.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/cardField" },
          "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" }
        },
        "lockedFields": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/cardField" } }
      }
    }
  }
}
