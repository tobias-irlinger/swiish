# Swiish Environment Configuration
# Copy this file to .env and fill in your values

# === REQUIRED VARIABLES ===

# JWT Secret Key - Used for signing authentication tokens
# Generate a strong random string using: openssl rand -base64 32
JWT_SECRET=change-this-secret-in-production



# Node Environment - Set to 'production' for production deployments
# Default: development
NODE_ENV=development

# Demo Mode - ⚠️ DEVELOPMENT & DEMO ONLY - DO NOT USE IN PRODUCTION
# When enabled (true), bypasses authentication, seeds database with demo data,
# and resets all data every 60 minutes.
DEMO_MODE=false

# Server Port - Port for the Express server to listen on
# Default: 3000
PORT=3000

# JWT Expiration - How long JWT tokens remain valid
# Default: 24h (24 hours)
JWT_EXPIRES_IN=24h

# Allowed Origins - Comma-separated list of allowed CORS origins
# Default: http://localhost:3000,http://localhost:8095
# For production, set to your actual domain(s)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8095

# Max File Size - Maximum file upload size in bytes
# Default: 5242880 (5MB)
MAX_FILE_SIZE=5242880

# Force HTTPS - Set to 'true' to force HTTPS redirects in production
# Default: false
# Note: Usually handled by reverse proxy (nginx, Traefik) in production
FORCE_HTTPS=false

# Application URL - Base URL for the application
# Required in production mode, optional in development
# For Docker (port 8095): http://localhost:8095
# For local dev (port 3000): http://localhost:3000
# For production: https://yourdomain.com
APP_URL=http://localhost:8095

# === EMAIL CONFIGURATION (Optional) ===
# Configure SMTP settings to enable email features (invitations, password resets, etc.)
# If not configured, emails will be logged to console in development mode

# SMTP Host - Your SMTP server hostname
SMTP_HOST=

# SMTP Port - SMTP server port (usually 587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP Secure - Set to 'true' for SSL (port 465), 'false' for TLS (port 587)
SMTP_SECURE=false

# SMTP User - SMTP authentication username
SMTP_USER=

# SMTP Password - SMTP authentication password
SMTP_PASSWORD=

# SMTP From - Email address to send from (defaults to noreply@localhost if not set)
SMTP_FROM=


# === OPENID CONNECT / SSO (Optional) ===
# Enables "Login with <provider>" via the Authorization Code flow with PKCE.
# SSO is active when both OIDC_ISSUER_URL and OIDC_CLIENT_ID are set.
# Register this redirect URI with your provider: <APP_URL>/api/auth/oidc/callback

# Issuer URL - must serve /.well-known/openid-configuration
# e.g. https://keycloak.example.com/realms/myrealm or https://login.microsoftonline.com/<tenant>/v2.0
OIDC_ISSUER_URL=

# Client ID and secret - leave the secret empty for a public client (PKCE only)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Redirect URI - defaults to <APP_URL>/api/auth/oidc/callback
OIDC_REDIRECT_URI=

# Scopes to request - must include openid and email
# Default: openid email profile
OIDC_SCOPES=openid email profile

# Label for the login button
# Default: SSO
OIDC_PROVIDER_NAME=SSO

# Existing users are linked by verified email on their first SSO login.
# Set to 'true' to also create accounts for unknown SSO users in the organisation.
# Default: false (only invited/existing users can log in)
OIDC_AUTO_PROVISION=false

# Role for auto-provisioned users: member or owner
# Default: member
OIDC_DEFAULT_ROLE=member

# Comma-separated list of email domains allowed to log in via SSO (empty = all)
OIDC_ALLOWED_DOMAINS=

# Require the provider to mark the email as verified before linking or provisioning
# Default: true
OIDC_REQUIRE_VERIFIED_EMAIL=true
